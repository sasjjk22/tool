    async function fetchMetals() {
        const statusEl = document.getElementById('metalStatus');
        statusEl.innerText = "正在获取实时金价...";

        if(!window.ratesLoaded) await fetchRates();

        const results = await Promise.allSettled(
            metalDefs.map(m => fetch(`https://api.gold-api.com/price/${m.symbol}`).then(r => {
                if(!r.ok) throw new Error(m.symbol);
                return r.json();
            }))
        );

        let successCount = 0;
        results.forEach((res, idx) => {
            const sym = metalDefs[idx].symbol;
            if(res.status === 'fulfilled' && res.value && typeof res.value.price === 'number') {
                metalPrices[sym] = res.value;
                successCount++;
            }
        });

        // 若主接口部分失败，尝试用 jsDelivr currency-api 兜底 XAU/XAG/XPT/XPD
        if(successCount < 4) {
            try {
                let fbRes = await fetch('https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json');
                let fbData = await fbRes.json();
                ['xau','xag','xpt','xpd'].forEach(lc => {
                    const uc = lc.toUpperCase();
                    if(!metalPrices[uc] && fbData.usd && fbData.usd[lc]) {
                        metalPrices[uc] = {
                            symbol: uc,
                            price: 1 / fbData.usd[lc],
                            updatedAtReadable: fbData.date + ' (备用源)'
                        };
                        successCount++;
                    }
                });
            } catch(e) {}
        }

        if(successCount > 0) {
            window.metalsLoaded = true;
            statusEl.innerText = "更新: " + new Date().toLocaleTimeString();
            renderMetals();
            calcMetalWeight();
        } else {
            statusEl.innerText = "贵金属行情获取失败，请稍后重试";
        }
    }

