            if(isNaN(targetMonthly)) { alert("请输入有效的月供"); return; }
        } else {
            targetTotalInterest = parseFloat(document.getElementById('revInterest').value) * 10000;
            if(isNaN(targetTotalInterest)) { alert("请输入有效的总利息"); return; }
        }

        let rate = 0, totalPayDisplay = 0;
        if(method === 'equal_principal') {
            if(mode === 'target_monthly_payment') {
                let monthlyPrincipal = P / n;
                if(targetMonthly <= monthlyPrincipal) { alert("输入的月供必须大于每月本金 (" + monthlyPrincipal.toFixed(2) + "元)"); return; }
                let r_month = (targetMonthly - monthlyPrincipal) / P;
                rate = r_month * 12;
                totalPayDisplay = P + (n+1)*P*r_month/2;
            } else {
                let r_month = (targetTotalInterest * 2) / ((n+1)*P);
                rate = r_month * 12;
                totalPayDisplay = P + targetTotalInterest;
            }
        } else {
            let targetM = (mode === 'target_interest') ? ((P + targetTotalInterest) / n) : targetMonthly;
            totalPayDisplay = (mode === 'target_interest') ? (P + targetTotalInterest) : (targetM * n);
            let min = 0, max = 1;
            for(let i=0; i<100; i++) {
                let mid = (min+max)/2;
                let k = Math.pow(1+mid, n);
                let m = P * mid * k / (k-1);
                if(m > targetM) max = mid; else min = mid;
                if(Math.abs(m - targetM) < 0.001) break;
            }
            rate = min * 12;
        }

        document.getElementById('revRateResult').innerText = (rate*100).toFixed(3) + "%";
        document.getElementById('revTotalPay').innerText = (totalPayDisplay/10000).toFixed(2) + " 万";
        let note = (method === 'equal_principal' && mode === 'target_monthly_payment')
            ? "基于首月月供反推"
            : (mode === 'target_monthly_payment' ? `总利息: ${((totalPayDisplay-P)/10000).toFixed(2)}万` : `参考月供: ${(totalPayDisplay/n).toFixed(0)}元`);
        document.getElementById('revOtherResult').innerText = note;
        document.getElementById('revResult').style.display = 'block';
    }

    function updateRevInputs() {
        let mode = document.getElementById('revMode').value;
        document.getElementById('inputMonthly').style.display = mode === 'target_monthly_payment' ? 'block' : 'none';
        document.getElementById('inputInterest').style.display = mode === 'target_interest' ? 'block' : 'none';
    }

    /* --- 初始化 --- */
    window.onload = function() {
        updateUnitOptions(); 
        updateRevInputs();
        initDensity();
        updateMetalPurityOptions();
        // 自动预加载实时汇率、贵金属克价与顶部重大新闻条框
        fetchRates();
        fetchMetals();
        fetchAllNews();
    };
</script>

