<script>
    /* --- 全局状态 --- */
    window.currentScheduleData = [];
    window.ratesLoaded = false;
    window.metalsLoaded = false;
    window.newsLoaded = false;

    function switchTab(name) {
        document.querySelectorAll('.content').forEach(e => e.classList.remove('active'));
        document.querySelectorAll('.nav-btn').forEach(e => {
            e.classList.toggle('active', e.dataset.tab === name);
        });
        document.getElementById(name).classList.add('active');
        if(name === 'forex' && !window.ratesLoaded) fetchRates();
        if(name === 'metals' && !window.metalsLoaded) fetchMetals();
        if(name === 'news' && !window.newsLoaded) fetchAllNews();
    }

    function resetInputs(id) {
        document.querySelectorAll(`#${id} input`).forEach(i => i.value = '');
        document.querySelectorAll(`#${id} .result-box`).forEach(b => b.style.display = 'none');
    }

    /* --- 🧮 科学计算器 --- */
    let calcExpr = "";
    function calcAppend(val) {
        if(val === '.' && calcExpr.endsWith('.')) return;
        if(calcExpr === "Error" || calcExpr === "Infinity") calcExpr = "";
        calcExpr += val;
        document.getElementById('calcDisplay').innerText = calcExpr;
    }
    function calcClear() { calcExpr = ""; document.getElementById('calcDisplay').innerText = "0"; }
    function calcDel() { calcExpr = calcExpr.slice(0, -1); document.getElementById('calcDisplay').innerText = calcExpr || "0"; }
    function calcResult() {
        try {
            if(calcExpr === "") return;
            let evalStr = calcExpr
                .replace(/×/g, '*').replace(/÷/g, '/').replace(/\^/g, '**')
                .replace(/π/g, 'Math.PI').replace(/e/g, 'Math.E')
                .replace(/sin\(/g, 'Math.sin(').replace(/cos\(/g, 'Math.cos(')
                .replace(/tan\(/g, 'Math.tan(').replace(/log\(/g, 'Math.log10(')
                .replace(/ln\(/g, 'Math.log(').replace(/sqrt\(/g, 'Math.sqrt(');

            if (!/^[0-9.\+\-\*\/\%\(\)\s(Math\.)]+$/.test(evalStr)) throw "Sec";
            let result = new Function('return ' + evalStr)();
            if(!isFinite(result)) throw "Err";
            result = parseFloat(result.toPrecision(12));
            calcExpr = result.toString();
            document.getElementById('calcDisplay').innerText = calcExpr;
        } catch(e) {
            calcExpr = "";
            document.getElementById('calcDisplay').innerText = "Error";
        }
    }

    /* --- 🏠 房贷计算 --- */
    let chartInstance = null;
    function calculateLoan() {
        window.currentScheduleData = [];
        let P = parseFloat(document.getElementById('loanAmount').value) * 10000;
        let R = parseFloat(document.getElementById('loanRate').value) / 100 / 12;
        let N = parseFloat(document.getElementById('loanYears').value) * 12;
        let type = document.getElementById('repaymentMethod').value;
        
        if(isNaN(P) || isNaN(R) || isNaN(N) || P<=0 || R<0 || N<=0) { alert("请输入有效的数值"); return; }

        let eMonth = parseInt(document.getElementById('earlyRepayMonth').value);
        let eAmount = parseFloat(document.getElementById('earlyRepayAmount').value) * 10000;
        let eType = document.getElementById('recalculateOption').value;
        let isEarly = (eMonth > 0 && eAmount >= 0 && eMonth < N);

        let diff = compareLoans(P, R, N);
        document.getElementById('compInterestDiff').innerText = (diff.int/10000).toFixed(2) + " 万";
        document.getElementById('compFirstPayDiff').innerText = diff.first.toFixed(2) + " 元";
        document.getElementById('comparisonResult').style.display = 'block';

        let balance = P, totalInt = 0, monthly = 0;
        let schedule = [], pNew = 0, nNew = N, monthlyNew = 0;
        let hasEarlyPay = false;

        if(type === 'equal_payment') {
            let k = Math.pow(1+R, N);
            monthly = P * R * k / (k-1);
        }

        for(let i=1; i<=N; i++) {
            let int = balance * R;
            let prin = 0, curPay = 0;

            if(type === 'equal_payment') {
                if(!hasEarlyPay) { prin = monthly - int; curPay = monthly; } 
                else {
                    if(eType === 'reduce_payment') { prin = monthlyNew - int; curPay = monthlyNew; } 
                    else { if(i > nNew) break; prin = monthlyNew - int; curPay = monthlyNew; }
                }
            } else {
                if(!hasEarlyPay) prin = P / N;
                else prin = pNew / (N - eMonth); 
                curPay = prin + int;
            }

            if(balance - prin < 0.1) { prin = balance; curPay = prin + int; balance = 0; }
            else { balance -= prin; }

            totalInt += int;
            schedule.push({i, prin, int, pay: curPay, bal: balance});

            if(isEarly && i === eMonth) {
                balance -= eAmount; if(balance < 0) balance = 0;
                hasEarlyPay = true; pNew = balance;
                schedule.push({i: i+"(提前)", prin: eAmount, int: 0, pay: eAmount, bal: balance});

                if(balance > 0) {
                    if(type === 'equal_payment') {
                        if(eType === 'reduce_payment') {
                            let remMonths = N - eMonth; let k = Math.pow(1+R, remMonths);
                            monthlyNew = balance * R * k / (k-1);
                        } else {
                            monthlyNew = monthly;
                            let temp = 1 - (balance * R / monthly);
                            if(temp <= 0) { nNew = i; balance = 0; }
                            else { let remN = -Math.log(temp) / Math.log(1+R); nNew = i + Math.ceil(remN); }
                        }
                    }
                } else break;
            }
            if(balance <= 0) break;
        }
        
        window.currentScheduleData = schedule;
        let firstPay = schedule[0] ? schedule[0].pay : 0;
        let totalPay = P + totalInt;
        
        document.getElementById('monthlyPayment').innerText = firstPay.toFixed(2) + " 元";
        document.getElementById('totalInterest').innerText = (totalInt/10000).toFixed(2) + " 万";
        document.getElementById('totalPayment').innerText = (totalPay/10000).toFixed(2) + " 万";

        if(hasEarlyPay) {
            let orgInt = (type === 'equal_payment') ? ((monthly * N) - P) : ((N+1)*P*R/2);
            let save = (orgInt - totalInt)/10000;
            document.getElementById('repaySavings').innerText = `⚡️ 节省约 ${save.toFixed(2)} 万元利息`;
            document.getElementById('earlyRepayResult').style.display = 'block';
        } else {
            document.getElementById('earlyRepayResult').style.display = 'none';
        }

        let html = schedule.map(r => `<tr><td>${r.i}</td><td>${r.prin.toFixed(2)}</td><td>${r.int.toFixed(2)}</td><td>${r.pay.toFixed(2)}</td><td>${r.bal.toFixed(2)}</td></tr>`).join('');
        document.querySelector('#scheduleTable tbody').innerHTML = html;

        document.getElementById('loanResult').style.display = 'block';
        document.getElementById('scheduleBox').style.display = 'block';
        document.getElementById('chartBox').style.display = 'flex';
        
        if(chartInstance) { chartInstance.destroy(); }
        chartInstance = new Chart(document.getElementById('loanChart'), {
            type: 'doughnut',
            data: { labels: ['本金', '总利息'], datasets: [{ data: [P, totalInt], backgroundColor: ['#007aff', '#ffcc00'] }] },
            options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });
    }

    function compareLoans(P, r, n) {
        let k = Math.pow(1+r, n);
        let m1 = P*r*k/(k-1);
        let int1 = m1*n - P;
        let int2 = (n+1)*P*r/2;
        let m2 = P/n + P*r;
        return { int: Math.abs(int1-int2), first: Math.abs(m1-m2) };
    }

    function exportCSV() {
        if(window.currentScheduleData.length === 0) { alert('请先计算'); return; }
        let csv = "\uFEFF期数,本金,利息,月供,剩余\n";
        window.currentScheduleData.forEach(r => csv += `${r.i},${r.prin.toFixed(2)},${r.int.toFixed(2)},${r.pay.toFixed(2)},${r.bal.toFixed(2)}\n`);
        let blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        let link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = "房贷计划.csv";
        link.click();
    }

    /* --- 💵 1美元实时汇率看板 + 货币换算 --- */
    const cNameMap = {
        'CNY':'人民币','USD':'美元','EUR':'欧元','JPY':'日元','GBP':'英镑',
        'HKD':'港币','KRW':'韩元','AUD':'澳元','CAD':'加元','SGD':'新加坡元',
        'CHF':'瑞士法郎','TWD':'新台币','THB':'泰铢','MYR':'马来西亚林吉特',
        'INR':'印度卢比','RUB':'俄罗斯卢布','NZD':'新西兰元','VND':'越南盾',
        'IDR':'印尼盾','PHP':'菲律宾比索'
    };
    const countryCodes = {
        'CNY':'cn','USD':'us','EUR':'eu','JPY':'jp','GBP':'gb',
        'HKD':'hk','KRW':'kr','AUD':'au','CAD':'ca','SGD':'sg',
        'CHF':'ch','TWD':'tw','THB':'th','MYR':'my','INR':'in',
        'RUB':'ru','NZD':'nz','VND':'vn','IDR':'id','PHP':'ph'
    };
    let rates = {}; // 以 USD 为基准: 1 USD = rates[code]

    async function fetchRates(manual = false) {
        const statusEl = document.getElementById('rateStatus');
        if(manual) statusEl.innerText = "正在刷新...";
        try {
            let res = await fetch('https://api.exchangerate-api.com/v4/latest/USD');
            if(!res.ok) throw new Error('primary failed');
            let data = await res.json();
            rates = data.rates;
            rates.USD = 1;
            window.ratesLoaded = true;
            statusEl.innerText = "更新: " + (data.date || new Date().toLocaleTimeString());
        } catch(e) {
            try {
                // 备用源: fawazahmed0 currency-api
                let res2 = await fetch('https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json');
                let data2 = await res2.json();
                rates = {};
                for(let k in data2.usd) rates[k.toUpperCase()] = data2.usd[k];
                rates.USD = 1;
                window.ratesLoaded = true;
                statusEl.innerText = "备用源更新: " + data2.date;
            } catch(err2) {
                statusEl.innerText = "汇率加载失败，请检查网络";
                return;
            }
        }

        let fromSel = document.getElementById('fromCurrency');
        let toSel = document.getElementById('toCurrency');
        if(fromSel.innerHTML === "") {
            let html = Object.keys(cNameMap).map(c => `<option value="${c}">${c} ${cNameMap[c]}</option>`).join('');
            fromSel.innerHTML = html;
            toSel.innerHTML = html;
            fromSel.value = 'USD';
            toSel.value = 'CNY';
            updateFlags();
        }
        renderUsdBoard();
        calculateForex();
        if(window.metalsLoaded) renderMetals(); // 同步更新贵金属的人民币克价
    }

    function renderUsdBoard() {
        const board = document.getElementById('usdBoard');
        if(!window.ratesLoaded) return;
        const kw = (document.getElementById('usdFilterInput').value || '').trim().toLowerCase();
        board.innerHTML = '';

        Object.keys(cNameMap).forEach(code => {
            if(code === 'USD' || !rates[code]) return;
            const cnName = cNameMap[code];
            if(kw && !code.toLowerCase().includes(kw) && !cnName.includes(kw)) return;

            const card = document.createElement('div');
            card.className = 'usd-card';
            card.onclick = () => {
                document.getElementById('fromCurrency').value = 'USD';
                document.getElementById('toCurrency').value = code;
                updateFlags();
                calculateForex();
            };

            const left = document.createElement('div');
            left.className = 'usd-left';
            const img = document.createElement('img');
            img.className = 'forex-flag';
            img.src = `https://flagcdn.com/w40/${countryCodes[code]}.png`;
            img.alt = code;
            const labelWrap = document.createElement('div');
            const title = document.createElement('span');
            title.style.fontWeight = '700';
            title.textContent = cnName;
            const sub = document.createElement('small');
            sub.textContent = `1 USD → ${code}`;
            labelWrap.appendChild(title);
            labelWrap.appendChild(sub);
            left.appendChild(img);
            left.appendChild(labelWrap);

            const valWrap = document.createElement('div');
            valWrap.className = 'usd-val';
            const rateNum = rates[code];
            valWrap.textContent = rateNum >= 100 ? rateNum.toFixed(2) : rateNum.toFixed(4);
            const revSub = document.createElement('small');
            revSub.textContent = `1 ${code} ≈ ${(1/rateNum).toFixed(4)} $`;
            valWrap.appendChild(revSub);

            card.appendChild(left);
            card.appendChild(valWrap);
            board.appendChild(card);
        });
    }

    function updateFlags() {
        let f = document.getElementById('fromCurrency').value;
        let t = document.getElementById('toCurrency').value;
        document.getElementById('fromFlag').src = `https://flagcdn.com/w40/${countryCodes[f]}.png`;
        document.getElementById('toFlag').src = `https://flagcdn.com/w40/${countryCodes[t]}.png`;
    }

    function calculateForex() {
        if(!window.ratesLoaded) return;
        let amt = parseFloat(document.getElementById('forexAmount').value);
        if(isNaN(amt)) { document.getElementById('forexResult').value = ""; return; }
        let f = document.getElementById('fromCurrency').value;
        let t = document.getElementById('toCurrency').value;
        let val = (amt / rates[f]) * rates[t];
        document.getElementById('forexResult').value = val.toFixed(4) + " " + t;
    }

    /* --- 🥇 贵金属单价克重 & 估值 --- */
    const TROY_OZ_GRAMS = 31.1034768;
    const LB_GRAMS = 453.59237;
    const metalDefs = [
        { symbol: 'XAU', name: '黄金', unitLabel: '盎司', gramsPerUnit: TROY_OZ_GRAMS, style: '' },
