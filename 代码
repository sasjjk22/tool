<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>终极全能计算器 (Ultra Pro)</title>
    
    <meta http-equiv="Content-Security-Policy" 
          content="default-src 'self'; 
                   script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; 
                   style-src 'self' 'unsafe-inline'; 
                   connect-src 'self' https://api.exchangerate-api.com https://cdn.jsdelivr.net https://api.gold-api.com https://api.gdeltproject.org https://api.rss2json.com; 
                   img-src 'self' data: https://flagcdn.com; 
                   object-src 'none'; 
                   frame-ancestors 'none';">

    <script>if(self!==top){top.location=self.location;}</script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* --- 🎨 核心 UI 设计 --- */
        :root { 
            --primary: #007aff; --primary-dark: #005bb5; 
            --bg: #f2f6fa; --card: #ffffff; --text: #333;
            --shadow: 0 8px 24px rgba(0,0,0,0.06);
        }
        
        body { 
            font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; 
            background-color: var(--bg); 
            display: flex; justify-content: center; 
            padding: 12px; margin: 0; color: var(--text); 
            -webkit-tap-highlight-color: transparent;
        }
        .container { 
            background: var(--card); width: 100%; max-width: 640px; 
            border-radius: 20px; box-shadow: var(--shadow); 
            overflow: hidden; display: flex; flex-direction: column; margin-bottom: 40px;
        }
        
        /* 头部 */
        .header-section { padding: 16px; background: linear-gradient(180deg, #eaf4ff 0%, #fff 100%); text-align: center; border-bottom: 1px solid #eee; }
        .header-section h1 { margin: 0 0 4px; font-size: 20px; color: #005bb5; font-weight: 800; }
        .header-section p { margin: 0; font-size: 12px; color: #666; }

        /* 📰 顶部重大新闻条框 */
        .news-ticker-bar {
            display: flex; align-items: center; gap: 8px;
            background: #1c2433; color: #fff; padding: 8px 12px;
            font-size: 12px; border-bottom: 1px solid #2b3548;
        }
        .ticker-badge {
            background: #ff3b30; color: #fff; font-weight: 700;
            padding: 2px 6px; border-radius: 4px; flex-shrink: 0; font-size: 11px;
        }
        .ticker-cat {
            background: rgba(255,255,255,0.14); color: #ffd60a;
            padding: 2px 6px; border-radius: 4px; flex-shrink: 0; font-size: 11px;
        }
        .ticker-link-wrap {
            flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
        }
        .ticker-link {
            color: #f2f4f8; text-decoration: none; cursor: pointer;
        }
        .ticker-link:hover { text-decoration: underline; color: #70b8ff; }
        .ticker-controls { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
        .ticker-btn {
            background: rgba(255,255,255,0.12); color: #fff; border: none;
            border-radius: 4px; padding: 2px 7px; font-size: 11px; cursor: pointer;
        }
        .ticker-btn:hover { background: rgba(255,255,255,0.24); }

        /* 🧭 导航栏 (四列双排) */
        .nav-grid { 
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; 
            padding: 10px 12px; background: #fff; border-bottom: 1px solid #eee; 
        }
        .nav-btn { 
            padding: 9px 2px; border: 1px solid #f0f0f0; background: #f8f9fa; 
            border-radius: 10px; font-size: 13px; font-weight: 600; color: #555; 
            cursor: pointer; transition: all 0.2s; white-space: nowrap;
        }
        .nav-btn.active { 
            background: #eff6ff; color: var(--primary); border-color: var(--primary); 
            box-shadow: 0 2px 5px rgba(0,122,255,0.1);
        }
        
        /* 内容区 */
        .content { padding: 18px 16px; display: none; animation: fadeIn 0.2s ease-out; }
        .content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: translateY(0); } }
        
        /* 表单控件 */
        .form-group { margin-bottom: 14px; }
        label { display: block; margin-bottom: 6px; font-weight: 600; font-size: 13px; color: #444; }
        
        input, select { 
            width: 100%; padding: 11px 12px; border: 1px solid #dce0e5; border-radius: 10px; 
            font-size: 15px; outline: none; box-sizing: border-box; background: #fff; appearance: none;
            transition: border 0.2s;
        }
        input:focus, select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(0,122,255,0.1); }
        
        /* 汇率特殊布局 */
        .forex-row { display: flex; align-items: center; gap: 8px; }
        .forex-row input { flex: 1; min-width: 0; font-weight: bold; color: var(--primary); }
        .forex-flag { width: 28px; height: 20px; border-radius: 3px; object-fit: cover; border: 1px solid #eee; flex-shrink: 0; }
        .forex-select { flex: 0 0 115px; }

        select { background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23007aff%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E"); background-repeat: no-repeat; background-position: right 10px center; background-size: 10px; padding-right: 25px; }

        /* 按钮 */
        button.action-btn { width: 100%; padding: 12px; background: linear-gradient(135deg, var(--primary), #0062cc); color: white; border: none; border-radius: 10px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 8px; box-shadow: 0 4px 12px rgba(0,122,255,0.2); }
        button.action-btn:active { transform: scale(0.98); }
        button.reset-btn { background: #f0f2f5; color: #666; border: 1px solid #e1e4e8; margin-top: 8px; padding: 10px; width: 100%; border-radius: 10px; cursor: pointer; font-size: 14px; }
        button.export-btn { width: 100%; padding: 12px; background: #34c759; color: white; border: none; border-radius: 10px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 15px; display: flex; align-items: center; justify-content: center; gap: 6px; }
        
        /* 结果展示 */
        .result-box { margin-top: 18px; padding: 15px; background: #f7faff; border: 1px solid #dceeff; border-radius: 12px; display: none; }
        .result-item { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 15px; border-bottom: 1px dashed #e6e6e6; padding-bottom: 8px; }
        .result-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
        .result-item strong { color: #007aff; font-weight: 700; }
        
        .comparison-box { background: #fffcf0; border-color: #ffeeba; margin-top: 15px; }
        .comparison-box h4 { color: #b37400 !important; margin: 0 0 10px 0; }
        .comparison-box .result-item strong { color: #b37400; }
        .early-repay-result { background: #eaffea; border: 1px solid #c3e6cb; color: #155724; padding: 12px; border-radius: 8px; margin-top: 15px; font-size: 14px; display: none; }

        .row-input { display: flex; gap: 10px; align-items: center; }
        .row-input input { flex: 2; }
        .row-input select { flex: 1; min-width: 0; } 
        
        .chart-wrapper { position: relative; height: 240px; width: 100%; margin-top: 20px; display: none; justify-content: center; }

        .schedule-container { margin-top: 20px; max-height: 300px; overflow-y: auto; border: 1px solid #e1e4e8; border-radius: 8px; display: none; -webkit-overflow-scrolling: touch; }
        table.schedule-tbl { width: 100%; border-collapse: collapse; font-size: 12px; text-align: center; white-space: nowrap; }
        table.schedule-tbl th { background: #f8f9fa; padding: 10px; position: sticky; top: 0; z-index: 1; color: #555; border-bottom: 1px solid #ddd; }
        table.schedule-tbl td { padding: 8px; border-bottom: 1px solid #eee; color: #666; }

        /* 💵 1美元实时汇率看板 */
        .section-title {
            margin: 18px 0 10px; font-size: 14px; color: #333; font-weight: 700;
            border-left: 4px solid var(--primary); padding-left: 8px;
            display: flex; justify-content: space-between; align-items: center;
        }
        .usd-grid {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 8px;
        }
        .usd-card {
            display: flex; justify-content: space-between; align-items: center;
            background: #f8fafd; border: 1px solid #e3ebf5; border-radius: 10px;
            padding: 9px 10px; cursor: pointer; transition: all 0.15s;
        }
        .usd-card:hover { border-color: var(--primary); background: #eff6ff; }
        .usd-left { display: flex; align-items: center; gap: 7px; font-size: 13px; color: #333; }
        .usd-left small { display: block; font-size: 11px; color: #888; }
        .usd-val { font-weight: 700; color: #005bb5; font-size: 14px; text-align: right; }
        .usd-val small { display: block; font-size: 10px; color: #888; font-weight: normal; }

        /* 🥇 贵金属克价看板 */
        .metal-grid {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 10px;
        }
        .metal-card {
            background: linear-gradient(145deg, #fffdf7, #fdf7e4);
            border: 1px solid #f0dfb0; border-radius: 12px; padding: 12px;
        }
        .metal-card.silver { background: linear-gradient(145deg, #fbfcfd, #eff3f7); border-color: #d7e0ea; }
        .metal-card.copper { background: linear-gradient(145deg, #fff9f5, #fceee5); border-color: #eed0bd; }
        .metal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
        .metal-name { font-weight: 800; font-size: 15px; color: #333; }
        .metal-sym { font-size: 11px; background: rgba(0,0,0,0.06); padding: 2px 6px; border-radius: 4px; color: #555; font-weight: 600; }
        .metal-cny { font-size: 19px; font-weight: 800; color: #b87300; margin: 4px 0; }
        .metal-card.silver .metal-cny { color: #3c4f65; }
        .metal-card.copper .metal-cny { color: #b54d1b; }
        .metal-sub { font-size: 12px; color: #666; line-height: 1.5; }

        /* 🗞️ 行业新闻筛选面板 */
        .pill-group { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
        .filter-pill {
            padding: 6px 11px; border-radius: 20px; border: 1px solid #dce0e5;
            background: #f8f9fa; color: #555; font-size: 12px; font-weight: 600; cursor: pointer;
        }
        .filter-pill.active { background: var(--primary); color: #fff; border-color: var(--primary); }
        .news-toolbar { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
        .news-toolbar input[type="text"] { flex: 1; padding: 9px 12px; font-size: 14px; }
        .major-toggle {
            display: flex; align-items: center; gap: 5px; font-size: 12px; color: #444;
            margin-bottom: 12px; cursor: pointer; user-select: none;
        }
        .major-toggle input { width: auto; padding: 0; margin: 0; appearance: checkbox; }
        .news-list { display: flex; flex-direction: column; gap: 10px; max-height: 460px; overflow-y: auto; }
        .news-card {
            display: block; text-decoration: none; color: inherit;
            background: #fafcff; border: 1px solid #e4ecf5; border-radius: 10px;
            padding: 11px 12px; transition: border-color 0.15s;
        }
        .news-card:hover { border-color: var(--primary); background: #f2f7ff; }
        .news-meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 11px; color: #888; margin-bottom: 5px; }
        .news-tag { background: #e8f1ff; color: #005bb5; padding: 2px 6px; border-radius: 4px; font-weight: 600; }
        .news-tag.major { background: #ffeaea; color: #d92b20; }
        .news-title { font-size: 14px; font-weight: 600; color: #222; line-height: 1.45; }

        /* 🧮 科学计算器 */
        .calc-screen {
            width: 100%; height: 80px; background: #1c1c1e; color: #fff; border-radius: 12px;
            font-size: 34px; text-align: right; padding: 15px; box-sizing: border-box;
            margin-bottom: 12px; font-family: monospace; overflow-x: auto; white-space: nowrap;
            display: flex; align-items: center; justify-content: flex-end;
        }
        .calc-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
        .calc-btn {
            padding: 14px 0; font-size: 18px; font-weight: 500; border: none; border-radius: 8px;
            background: #e5e5e5; color: #000; cursor: pointer; transition: all 0.1s;
            display: flex; justify-content: center; align-items: center;
        }
        .calc-btn:active { transform: scale(0.92); filter: brightness(0.9); }
        .btn-op { background: #ff9f0a; color: white; font-size: 22px; font-weight: 600; }
        .btn-sci { background: #3a3a3c; color: #fff; font-size: 14px; font-weight: 600; }
        .btn-eq { background: var(--primary); color: white; grid-column: span 2; font-size: 24px; }
        .btn-ac { background: #ff453a; color: white; font-weight: 700; }
        .btn-del { background: #ff453a; color: white; font-size: 16px; }
    </style>
</head>
<body>

<div class="container">
    <div class="header-section">
        <h1>🚀 终极全能计算器</h1>
        <p>实时汇率・贵金属克价・行业快讯・工程助手</p>
    </div>

    <!-- 📰 顶部各行业重大新闻条框 -->
    <div class="news-ticker-bar" id="newsTickerBar">
        <span class="ticker-badge">重大快讯</span>
        <span class="ticker-cat" id="tickerCat">加载中</span>
        <div class="ticker-link-wrap">
            <a id="tickerLink" class="ticker-link" href="#" target="_blank" rel="noopener noreferrer">正在从全网获取各行业最新动态...</a>
        </div>
        <div class="ticker-controls">
            <button class="ticker-btn" onclick="stepTicker(-1)" title="上一条">‹</button>
            <button class="ticker-btn" onclick="stepTicker(1)" title="下一条">›</button>
            <button class="ticker-btn" onclick="switchTab('news')">筛选</button>
        </div>
    </div>

    <!-- 🧭 导航栏 -->
    <div class="nav-grid">
        <button class="nav-btn active" data-tab="loan" onclick="switchTab('loan')">房贷计算</button>
        <button class="nav-btn" data-tab="reverse" onclick="switchTab('reverse')">反推利率</button>
        <button class="nav-btn" data-tab="calc" onclick="switchTab('calc')">科学计算</button>
        <button class="nav-btn" data-tab="forex" onclick="switchTab('forex')">1美元汇率</button>
        <button class="nav-btn" data-tab="metals" onclick="switchTab('metals')">贵金属克价</button>
        <button class="nav-btn" data-tab="news" onclick="switchTab('news')">行业新闻</button>
        <button class="nav-btn" data-tab="unit" onclick="switchTab('unit')">工程换算</button>
        <button class="nav-btn" data-tab="density" onclick="switchTab('density')">材质密度</button>
    </div>

    <!-- 1. 房贷计算 -->
    <div id="loan" class="content active">
        <div class="form-group">
            <label>还款方式</label>
            <select id="repaymentMethod">
                <option value="equal_payment">等额本息 (每月固定)</option>
                <option value="equal_principal">等额本金 (逐月递减)</option>
            </select>
        </div>
        <div class="row-input form-group">
            <div style="flex:1">
                <label>贷款金额 (万元)</label>
                <input type="number" id="loanAmount" placeholder="100" min="0" inputmode="decimal">
            </div>
            <div style="flex:1">
                <label>年利率 (%)</label>
                <input type="number" id="loanRate" placeholder="3.2" min="0" inputmode="decimal">
            </div>
        </div>
        <div class="form-group">
            <label>贷款期限 (年)</label>
            <input type="number" id="loanYears" placeholder="30" min="1" inputmode="numeric">
        </div>

        <h4 style="margin: 20px 0 10px; font-size:14px; color:#555; border-left: 4px solid #ff9f0a; padding-left: 8px;">提前还款 (可选)</h4>
        <div class="row-input form-group">
            <div style="flex:1">
                <label>第几期还款</label>
                <input type="number" id="earlyRepayMonth" placeholder="如 24" min="1" inputmode="numeric">
            </div>
            <div style="flex:1">
                <label>还款额 (万)</label>
                <input type="number" id="earlyRepayAmount" placeholder="如 10" min="0" inputmode="decimal">
            </div>
        </div>
         <div class="form-group">
            <label>还款后策略</label>
            <select id="recalculateOption">
                <option value="reduce_term">缩短期限 (月供不变)</option>
                <option value="reduce_payment">减少月供 (期限不变)</option>
            </select>
        </div>
        
        <button class="action-btn" onclick="calculateLoan()">开始计算</button>
        <button class="reset-btn" onclick="resetInputs('loan')">重置所有输入</button>

        <div id="comparisonResult" class="comparison-box result-box">
            <h4>💰 方式对比 (本息 vs 本金)</h4>
            <div class="result-item"><span>总利息差：</span><strong id="compInterestDiff">0 万</strong></div>
            <div class="result-item"><span>首月差额：</span><strong id="compFirstPayDiff">0 元</strong></div>
        </div>

        <div id="loanResult" class="result-box">
            <div class="result-item"><span>首月月供：</span><strong id="monthlyPayment">0 元</strong></div>
            <div class="result-item"><span>总支付利息：</span><strong id="totalInterest">0 万</strong></div>
            <div class="result-item"><span>本息合计：</span><strong id="totalPayment">0 万</strong></div>

            <div id="earlyRepayResult" class="early-repay-result"><span id="repaySavings"></span></div>
            <button class="export-btn" onclick="exportCSV()">📥 导出计划表</button>

            <div class="chart-wrapper" id="chartBox"><canvas id="loanChart"></canvas></div>

            <h4 style="margin: 20px 0 10px; color:#555; border-left: 4px solid #007aff; padding-left: 8px;">月度明细</h4>
            <div class="schedule-container" id="scheduleBox">
                <table class="schedule-tbl" id="scheduleTable">
                    <thead><tr><th>期数</th><th>本金</th><th>利息</th><th>月供</th><th>剩余</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 2. 反推利率 -->
    <div id="reverse" class="content">
        <div style="background:#fffbf0; padding:12px; border-radius:8px; font-size:13px; color:#b37400; margin-bottom:15px; border:1px solid #ffeeba;">
            💡 已知放款额和月供，反算真实年化利率(IRR)。<br>
            *注: 若选择等额本金模式，月供请填<b>首月月供</b>。
        </div>
        <div class="form-group">
            <label>反推模式</label>
            <select id="revMode" onchange="updateRevInputs()">
                <option value="target_monthly_payment">已知月供 -> 求利率</option>
                <option value="target_interest">已知总利息 -> 求利率</option>
            </select>
        </div>
        <div class="form-group">
            <label>还款方式</label>
            <select id="revMethod">
                <option value="equal_payment">等额本息</option>
                <option value="equal_principal">等额本金</option>
            </select>
        </div>
        <div class="row-input form-group">
            <div style="flex:1">
                <label>本金(万)</label>
                <input type="number" id="revPrincipal" placeholder="100" min="0" inputmode="decimal">
            </div>
            <div style="flex:1">
                <label>期限(年)</label>
                <input type="number" id="revYears" placeholder="30" min="1" inputmode="numeric">
            </div>
        </div>
        <div class="form-group" id="inputMonthly">
            <label>月供(元)</label>
            <input type="number" id="revMonthly" placeholder="如 4500" min="0" inputmode="decimal">
        </div>
        <div class="form-group" id="inputInterest" style="display:none;">
            <label>总利息(万)</label>
            <input type="number" id="revInterest" placeholder="如 0.7" min="0" inputmode="decimal">
        </div>
        <button class="action-btn" onclick="calculateReverseRate()">反向推算</button>
        <button class="reset-btn" onclick="resetInputs('reverse')">重置输入</button>
        <div id="revResult" class="result-box reverse-box">
            <div class="result-item"><span>真实年化利率：</span><strong id="revRateResult" style="color:#ff3b30; font-size:1.3em;">0.00%</strong></div>
            <div class="result-item"><span>还款总额：</span><strong id="revTotalPay">0 万</strong></div>
            <div class="result-item"><span>补充信息：</span><strong id="revOtherResult">--</strong></div>
        </div>
    </div>

    <!-- 3. 科学计算 -->
    <div id="calc" class="content">
        <div class="calc-screen" id="calcDisplay">0</div>
        <div class="calc-grid">
            <button class="calc-btn btn-ac" onclick="calcClear()">AC</button>
            <button class="calc-btn btn-del" onclick="calcDel()">⌫</button>
            <button class="calc-btn btn-sci" onclick="calcAppend('(')">(</button>
            <button class="calc-btn btn-sci" onclick="calcAppend(')')">)</button>
            <button class="calc-btn btn-op" onclick="calcAppend('/')">÷</button>
            
            <button class="calc-btn btn-sci" onclick="calcAppend('sin(')">sin</button>
            <button class="calc-btn btn-sci" onclick="calcAppend('cos(')">cos</button>
            <button class="calc-btn btn-sci" onclick="calcAppend('tan(')">tan</button>
            <button class="calc-btn btn-sci" onclick="calcAppend('log(')">log</button>
            <button class="calc-btn btn-op" onclick="calcAppend('*')">×</button>

            <button class="calc-btn" onclick="calcAppend('7')">7</button>
            <button class="calc-btn" onclick="calcAppend('8')">8</button>
