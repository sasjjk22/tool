    async function fetchAllNews(manual = false) {
        const now = Date.now();
        const statusEl = document.getElementById('newsStatus');
        if(manual && now - lastNewsFetchTime < 5000) {
            statusEl.innerText = "请求过快，请5秒后再刷新";
            return;
        }
        lastNewsFetchTime = now;
        statusEl.innerText = "正在全网抓取并筛选...";

        // 1) GDELT DOC 2.0 全球中文财经科技行业新闻
        const gdeltQuery = encodeURIComponent('(人工智能 OR 芯片 OR 金融 OR 央行 OR 黄金 OR 原油 OR 新能源 OR 汽车 OR 医药 OR 科技 OR 经济) sourcelang:chinese');
        const gdeltUrl = `https://api.gdeltproject.org/api/v2/doc/doc?query=${gdeltQuery}&mode=artlist&maxrecords=50&format=json&sort=DateDesc&timespan=7d`;

        // 2) RSS2JSON 补充源 (36氪 & BBC中文)
        const rssSources = [
            'https://api.rss2json.com/v1/api.json?rss_url=' + encodeURIComponent('https://36kr.com/feed'),
            'https://api.rss2json.com/v1/api.json?rss_url=' + encodeURIComponent('https://feeds.bbci.co.uk/zhongwen/simp/rss.xml')
        ];

        const [gdeltRes, ...rssResList] = await Promise.allSettled([
            fetch(gdeltUrl).then(r => r.ok ? r.json() : null),
            ...rssSources.map(u => fetch(u).then(r => r.ok ? r.json() : null))
        ]);

        const merged = [];
        const seenTitles = new Set();

        const pushItem = (title, url, source, timeStr) => {
            if(!title || !url) return;
            const cleanTitle = title.trim();
            if(cleanTitle.length < 6 || seenTitles.has(cleanTitle)) return;
            if(!/^https?:\/\//i.test(url)) return;
            seenTitles.add(cleanTitle);
            const cat = classifyArticle(cleanTitle);
            merged.push({
                title: cleanTitle,
                url,
                source: source || '网络资讯',
                time: timeStr || '最新',
                industry: cat.key,
                industryLabel: cat.label,
                isMajor: isMajorHeadline(cleanTitle)
            });
        };

        if(gdeltRes.status === 'fulfilled' && gdeltRes.value && Array.isArray(gdeltRes.value.articles)) {
            gdeltRes.value.articles.forEach(a => {
                pushItem(a.title, a.url, a.domain, formatGdeltDate(a.seendate));
            });
        }

        rssResList.forEach(r => {
            if(r.status === 'fulfilled' && r.value && r.value.status === 'ok' && Array.isArray(r.value.items)) {
                const feedName = (r.value.feed && r.value.feed.title) ? r.value.feed.title.split(' ')[0] : 'RSS快讯';
                r.value.items.forEach(it => {
                    pushItem(it.title, it.link, feedName, (it.pubDate || '').slice(0, 16));
                });
            }
        });

        if(merged.length > 0) {
            // 优先把含“重大”关键词的排到前面一点或保留时间顺序
            allNewsItems = merged;
            window.newsLoaded = true;
            statusEl.innerText = `已筛选 ${merged.length} 条 · ${new Date().toLocaleTimeString()}`;
            renderNewsList();
            startTicker();
        } else {
            statusEl.innerText = "暂未获取到新闻，请点击刷新重试";
            document.getElementById('tickerLink').textContent = "新闻源暂时繁忙，点击右侧“筛选”可手动重试";
        }
